# CloudOps Guard web -- example environment file (Phase 3I).
#
# Copy this to `.env` (or `.env.local`) for local development ONLY. Never
# commit a real `.env`/`.env.local`/`.dev.vars` file -- both are already
# excluded via .gitignore. This file contains placeholder documentation
# only: no real site key, secret, address, or token.
#
# PUBLIC_TURNSTILE_SITE_KEY is the only variable the website build itself
# reads (via `import.meta.env.PUBLIC_TURNSTILE_SITE_KEY` in
# src/pages/request-demo.astro and src/pages/feedback.astro). It is a
# PUBLIC Cloudflare Turnstile *site* key -- safe to expose to the browser,
# unlike the secret key below.
#
# For local development and CI, use Cloudflare's official, publicly
# documented "always passes" test site key -- this is a published testing
# identifier, not a secret:
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# --------------------------------------------------------------------------
# The following are Worker-only bindings (web/worker/), never read by the
# Astro site build and never exposed to the browser. They are listed here
# for local Worker-level testing/reference only -- Phase 3I does not
# configure real Cloudflare bindings, secrets, or deployment; that is
# Phase 3K. Do not put a real secret in this file even for local use --
# use Cloudflare's official test secret key documented at
# https://developers.cloudflare.com/turnstile/troubleshooting/testing/
# for any local Worker testing, never a production secret.
# --------------------------------------------------------------------------
# TURNSTILE_SECRET_KEY=
# TURNSTILE_EXPECTED_HOSTNAME=
# CONTACT_TO_EMAIL=
# CONTACT_FROM_EMAIL=
