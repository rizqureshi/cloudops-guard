---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { DemoController } from "../../features/demo-controller";
import { parseKubernetesReport } from "../../features/report-import";
import earlierReportRaw from "../../data/synthetic-kubernetes-report.json";
import laterReportRaw from "../../data/synthetic-kubernetes-report-later.json";

// Parsed at build time through the same untrusted-input validation path a
// real imported report would go through (see ../../features/report-import).
// If either synthetic fixture ever drifted from the released Kubernetes
// report contract, or its supplied summary stopped matching its findings,
// this call would throw and the build would fail loudly -- exactly the
// intended outcome (see docs/milestones/v0.3.0-interactive-web-demo.md,
// section H: "A synthetic report that the site's own parser would reject
// is a bug").
const earlierReport = parseKubernetesReport(earlierReportRaw);
const laterReport = parseKubernetesReport(laterReportRaw);
---

<BaseLayout
  title="Kubernetes demo — CloudOps Guard"
  description="An interactive, synthetic-data demonstration of a CloudOps Guard Kubernetes audit -- search, filter, compare two scan states, and inspect example findings entirely in your browser."
>
  <section class="section">
    <div class="container container--narrow">
      <p class="status-label status-label--neutral">Interactive demonstration</p>
      <h1>Kubernetes audit demo</h1>
      <p>
        This page shows what a CloudOps Guard Kubernetes audit finds, using two fixed, synthetic
        example reports for the same fictional cluster &mdash; not a live cluster. No Kubernetes
        cluster, kubeconfig, or credential is contacted or requested by this page. Everything below
        runs entirely in your browser.
      </p>
    </div>
  </section>

  <section class="section section--muted">
    <div class="container">
      <DemoController
        earlierReport={earlierReport}
        laterReport={laterReport}
        earlierLabel="Earlier scan (2026-06-01)"
        laterLabel="Later scan (2026-06-15)"
        client:load
      />
    </div>
  </section>
</BaseLayout>
