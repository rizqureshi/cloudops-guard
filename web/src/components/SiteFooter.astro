---
// As of Phase 3H, "/checks", "/learn", "/roadmap", and "/privacy" are
// implemented, so this footer links to them. Contact/feedback links
// (/request-demo, /feedback) remain unimplemented until Phase 3I and are
// deliberately not linked here.
const year = new Date().getUTCFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <p class="site-footer__identity">
      <strong>CloudOps Guard</strong> &mdash; read-only auditing for Kubernetes and
      GitLab CI/CD.
    </p>
    <nav class="site-footer__nav" aria-label="Footer">
      <a href="/checks">Checks</a>
      <a href="/learn">Learn</a>
      <a href="/roadmap">Roadmap</a>
      <a href="/privacy">Privacy</a>
    </nav>
    <p class="site-footer__privacy">
      This site never uploads or transmits an audit report you select on it &mdash;
      report exploration runs entirely in your browser.
    </p>
    <p class="site-footer__meta">&copy; {year} CloudOps Guard.</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    background: var(--color-surface);
    margin-top: var(--space-2xl);
  }

  .site-footer__inner {
    padding-block: var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }

  .site-footer__identity {
    margin: 0;
    color: var(--color-text);
  }

  .site-footer__nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-block: var(--space-2xs);
  }

  .site-footer__nav a {
    font-size: var(--font-size-sm);
    color: var(--color-brand-600);
    text-decoration: none;
  }

  .site-footer__nav a:hover {
    text-decoration: underline;
  }

  .site-footer__privacy {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
    max-width: var(--container-narrow);
  }

  .site-footer__meta {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
  }
</style>
